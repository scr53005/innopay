generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model bip39seedandaccount {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique(map: "bip39seedandaccount_userid_key")
  seed        String
  accountName String   @unique(map: "bip39seedandaccount_accountname_key") @db.VarChar(16)
  hivetxid    String?  @unique
  innouser    innouser @relation(fields: [userId], references: [id], map: "bip39seedandaccount_userid_fkey")
}

model innouser {
  id                  Int                   @id @default(autoincrement())
  email               String                @unique
  phoneNumber         String?
  createdAt           DateTime              @default(now())
  verified            Boolean               @default(false)
  bip39seedandaccount bip39seedandaccount?
  topup               topup[]
  bonus               bonus[]
  walletuser          walletuser[]
  email_verification  email_verification[]
}

model topup {
  id         Int      @id @default(autoincrement())
  userId     Int
  amountEuro Decimal  @db.Decimal(65, 2)
  topupAt    DateTime @default(now())
  innouser   innouser @relation(fields: [userId], references: [id], map: "topup_userid_fkey")
}

model walletuser {
  id             Int       @id @default(autoincrement())
  accountName    String    @unique
  creationDate   DateTime  @default(now())
  hivetxid       String    @db.Char(40)
  seed           String?   @db.Text
  masterPassword String?   @db.VarChar(64)
  userId         Int?
  profileName    String?   @db.VarChar(64)
  profileAvatar  String?   @db.VarChar(255)
  profileBckgrd  String?   @db.VarChar(255)
  profileAbout   String?   @db.VarChar(255)
  profileLoc     String?   @db.VarChar(255)
  profileWeb     String?   @db.VarChar(255)
  innouser       innouser? @relation(fields: [userId], references: [id])
  bonus          bonus[]
}

model campaign {
  id           Int       @id @default(autoincrement())
  name         String    @db.VarChar(64)
  startDate    DateTime  @default(now())
  endDate      DateTime?
  minAmount50  Decimal   @db.Decimal(10, 2)
  bonus50      Decimal   @db.Decimal(10, 2)
  maxUsers50   Int
  minAmount100 Decimal   @db.Decimal(10, 2)
  bonus100     Decimal   @db.Decimal(10, 2)
  maxUsers100  Int
  active       Boolean   @default(true)
  bonus        bonus[]
}

model bonus {
  id           Int         @id @default(autoincrement())
  campaignId   Int
  userId       Int?
  walletUserId Int?
  accountName  String      @db.VarChar(16)
  bonusAmount  Decimal     @db.Decimal(10, 2)
  grantedAt    DateTime    @default(now())
  campaign     campaign    @relation(fields: [campaignId], references: [id])
  innouser     innouser?   @relation(fields: [userId], references: [id])
  walletuser   walletuser? @relation(fields: [walletUserId], references: [id])
}

model guestcheckout {
  id              Int       @id @default(autoincrement())
  stripeSessionId String    @unique
  amountEuro      Decimal   @db.Decimal(10, 2)
  amountHbd       Decimal   @db.Decimal(10, 4)
  recipient       String    @db.VarChar(16)
  memo            String    @db.Text
  hiveTxId        String?   @db.Char(40)
  status          String    @db.VarChar(30)
  createdAt       DateTime  @default(now())
  completedAt     DateTime?
}

model currencyConversion {
  id             Int      @id @default(autoincrement())
  date           DateTime
  // Exchange pair this row caches, e.g. 'EUR/USD' (legacy default) or 'RON/USD'.
  // conversionRate is stored as "USD per 1 unit of the pair's fiat" (usdPerFiat).
  pair           String   @default("EUR/USD") @db.VarChar(12)
  conversionRate Decimal  @db.Decimal(10, 6)
  createdAt      DateTime @default(now())

  @@unique([date, pair])
  @@map("currency_conversion")
}

// masterPassword / owner* / posting* are optional (2026-11-03): sessions for an EXISTING wallet
// (Flow 5 Branch A, /api/execute-order-payment) carry only active + memo — handing the
// owner-deriving master password to anyone who merely proves the active key would turn a
// stolen active key into an account takeover. New-account sessions still carry the full set
// (one-time credential display).
model accountCredentialSession {
  id              String   @id @default(cuid())
  accountName     String
  stripeSessionId String   @unique
  masterPassword  String?  @db.VarChar(64)
  ownerPrivate    String?  @db.Text
  ownerPublic     String?  @db.Text
  activePrivate   String   @db.Text
  activePublic    String   @db.Text
  postingPrivate  String?  @db.Text
  postingPublic   String?  @db.Text
  memoPrivate     String   @db.Text
  memoPublic      String   @db.Text
  euroBalance     Decimal  @db.Decimal(10, 2) @default(0.00)
  email           String?  @db.VarChar(255)
  retrieved       Boolean  @default(false)
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@map("account_credential_session")
}

// Replay guard for the secure spoke→hub wallet hand-off. Each signed challenge is
// single-use: verify inserts the nonce, and a unique violation on a re-presented
// nonce means "already used" → reject. Freshness (≤2 min) is checked from the ts
// in the URL, so old rows are just harmless residue (periodically pruned).
model handoff_challenge {
  id        String   @id @default(cuid())
  account   String   @db.VarChar(16)
  nonce     String   @unique
  createdAt DateTime @default(now())

  @@map("handoff_challenge")
}

// One row per customer leg-1 transaction (Flow 6 / call-waiter: customer IOU tokens →
// innopay). Security fix 2026-11-02, reworked 2026-11-03 for latency:
//   'broadcast' — written by /api/sign-and-broadcast right after IT broadcast the leg-1
//                 transfer: the hub's own receipt (only the hub can create one), so
//                 /api/wallet-payment needs no chain lookup (the HE wait cost ~20 s).
//   'claimed'   — wallet-payment took it (atomic broadcast→claimed: single use);
//   'paid' | 'failed' — after the innopay → restaurant transfer ('failed' may be retried);
//   'unbacked'  — the post-response Hive-Engine audit found the transfer did NOT execute.
// recipient is unknown at broadcast time (leg 1 goes to innopay) → set when claimed.
model wallet_payment_claim {
  customer_tx_id   String   @id @db.VarChar(40)
  customer_account String   @db.VarChar(16)
  recipient        String?  @db.VarChar(16)
  token_symbol     String   @db.VarChar(10)
  quantity         Decimal  @db.Decimal(12, 3)
  memo             String?  @db.Text
  status           String   @default("claimed") @db.VarChar(10)
  restaurant_tx_id String?  @db.Char(40)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
}

// One row per order rewarded with RUBIS (RUBIS-PLAN.md §2). order_key is unique per order and
// per payment path ('wallet:<customer leg-1 tx>', 'stripe:<session id>', 'direct:<customer
// EURO tx>'), so a retried Stripe webhook or a repeated call can never pay twice: the row is
// written BEFORE the broadcast. status: pending → sent | failed (failed = retry candidate).
model rubis_reward {
  id               String   @id @default(cuid())
  order_key        String   @unique @db.VarChar(80)
  customer_account String   @db.VarChar(16)
  spoke_id         String   @db.VarChar(50)
  recipient        String   @db.VarChar(16)
  order_total      Decimal  @db.Decimal(10, 2)
  tip              Decimal  @default(0) @db.Decimal(10, 2)
  rubis_spent      Decimal  @default(0) @db.Decimal(12, 2) // RUBIS used to pay part of the order: earns nothing
  rate             Decimal  @db.Decimal(6, 4)
  tip_multiplier   Decimal  @db.Decimal(4, 2)
  rubis_amount     Decimal  @db.Decimal(12, 2)
  status           String   @default("pending") @db.VarChar(10)
  rubis_tx_id      String?  @db.Char(40)
  error            String?  @db.Text
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@index([customer_account])
  @@index([status])
}

/// One row per customer payment that /api/sign-and-broadcast signed with @innopay's own active
/// key instead of the customer's. Liman counts these to decide when the no-key fallback can be
/// retired. Written only after a successful broadcast, so tx_id is always the real Hive tx id.
model innopay_authority_signing {
  id         String   @id @default(cuid())
  signer     String   @db.VarChar(16)
  mode       String   @db.VarChar(10) // explicit (no local key sent) | fallback (customer key rejected)
  symbol     String   @db.VarChar(10)
  quantity   Decimal  @db.Decimal(18, 8)
  to_account String   @db.VarChar(16)
  tx_id      String   @db.Char(40)
  created_at DateTime @default(now())

  @@index([created_at])
  @@index([signer])
}

model outstanding_debt {
  id              String    @id @default(cuid())
  created_at      DateTime  @default(now())
  creditor        String    @db.VarChar(16)
  debtor          String    @default("innopay") @db.VarChar(16)
  amount_hbd      Decimal   @default(0) @db.Decimal(10, 3)
  original_amount Decimal?  @db.Decimal(10, 3) // immutable — set at creation, null for legacy rows until backfilled
  // For multi-currency: fiat_currency/token_symbol say how to read the (historically
  // EUR-named) amount_euro, euro_tx_id and eur_usd_rate columns. Defaults preserve all
  // existing rows as EUR/EURO; RON spokes write 'RON'/'LEI' and those columns then hold
  // the RON amount, LEI tx id and RON/USD rate respectively. amount_hbd stays canonical.
  fiat_currency   String    @default("EUR") @db.VarChar(8)
  token_symbol    String    @default("EURO") @db.VarChar(16)
  amount_euro     Decimal?  @db.Decimal(10, 2)
  euro_tx_id      String?   @db.Char(40)
  hbd_tx_id       String?   @db.Char(40)
  eur_usd_rate    Decimal   @db.Decimal(10, 4)
  reason          String    @db.VarChar(64)
  status          String    @default("unpaid") @db.VarChar(30) // unpaid | recovery_ongoing | withdrawal_pending | paid | settled_out_of_band
  paid_at         DateTime?
  payment_tx_id   String?   @db.Char(40)
  settlement_id   String?   @db.VarChar(30) // active Liman customer repayment
  notes           String?   @db.Text
  payments        debt_payment[]
}

model debt_payment {
  id          String   @id @default(cuid())
  debt_id     String
  amount_hbd  Decimal  @db.Decimal(10, 3)
  tx_id       String?  @db.VarChar(64)
  paid_at     DateTime @default(now())
  notes       String?  @db.Text
  settlement_key String? @unique @db.VarChar(100) // repayment id + leg + debt id

  debt        outstanding_debt @relation(fields: [debt_id], references: [id])

  @@index([debt_id])
}

model email_verification {
  id          String    @id @default(cuid())
  user_id     Int
  email       String    @db.VarChar(255)
  code        String    @db.VarChar(6)
  created_at  DateTime  @default(now())
  expires_at  DateTime
  attempts    Int       @default(0)
  verified    Boolean   @default(false)
  verified_at DateTime?
  ip_address  String?   @db.VarChar(45)

  innouser    innouser  @relation(fields: [user_id], references: [id])

  @@index([email, verified])
  @@index([user_id, verified])
}

model spoke {
  // Identity
  id          String @id @db.VarChar(50)
  name        String @db.VarChar(100)
  type        String @db.VarChar(50)

  // Environment URLs
  domain_prod String @db.VarChar(255)
  port_dev    Int

  // Routing
  path        String @db.VarChar(100)

  // Simple Attributes (for basic query params like table number)
  attribute_name_1        String? @db.VarChar(50)
  attribute_default_1     String? @db.VarChar(100)
  attribute_storage_key_1 String? @db.VarChar(100)

  attribute_name_2        String? @db.VarChar(50)
  attribute_default_2     String? @db.VarChar(100)
  attribute_storage_key_2 String? @db.VarChar(100)

  attribute_name_3        String? @db.VarChar(50)
  attribute_default_3     String? @db.VarChar(100)
  attribute_storage_key_3 String? @db.VarChar(100)

  // Images (for hub's nearby businesses display)
  image_1 String? @db.VarChar(255)
  image_2 String? @db.VarChar(255)
  image_3 String? @db.VarChar(255)

  // Features & Capabilities
  has_delivery Boolean @default(false)

  // Currency — the fiat this spoke prices in + its 1:1 Hive-Engine IOU token.
  // Defaults keep every existing spoke on EUR/EURO; non-Eurozone spokes override
  // (e.g. zenbar → RON/LEI). Authoritative source for the engine's CurrencyConfig.
  fiat_currency String @default("EUR") @db.VarChar(8)
  iou_token     String @default("EURO") @db.VarChar(16)

  // Memo `V:` token — ecosystem-wide numeric vendor id (canonical grammar:
  // SPOKE-DOCUMENTATION.md → MEMO GRAMMAR). Assigned: 1=indies,
  // 2=croque-bedaine, 3=millewee, 4=zenbar. Farm (innohatch) vendors
  // continue the sequence in innohatch's vendor table (5+); this registry
  // is the authoritative source — ranges must never collide. Emitted
  // unpadded (V:1, V:147). Nullable: container spokes (innohatch itself)
  // are not vendors and carry no number.
  memo_vendor_id Int? @unique

  // Interaction model (HATCHERY-PLAN.md §14/§15): primary model +
  // capability flags. Values: table_remote | counter_f2f | unattended |
  // venue_umbrella | waiter_mode | self_order. Drives bell urgency,
  // consume cadence/push policy, TABLE-vs-Q: memo semantics, till UI.
  service_model String   @default("table_remote") @db.VarChar(30)
  service_flags String[] @default([])

  // RUBIS "contract" (RUBIS-PLAN.md, 2026-11-03): RUBIS the HUB sends the paying customer per
  // fiat unit spent at this spoke. null = this spoke does not distribute (balance still shown).
  // Tips earn rate × rubis_tip_multiplier (tip capped at 50 % of the subtotal, lib/rubis.ts).
  rubis_rate           Decimal? @db.Decimal(6, 4)
  rubis_tip_multiplier Decimal  @default(2) @db.Decimal(4, 2)
  // Max share of a bill's FOOD subtotal the spoke accepts in RUBIS (tips are never payable in
  // RUBIS). RUBIS are spent automatically first, up to this cap (lib/rubis-redemption.ts).
  // Default 25 %; adjustable from the admin back-end. 0 = RUBIS not accepted.
  rubis_max_redeem_fraction Decimal @default(0.25) @db.Decimal(4, 3)

  // Status
  active  Boolean @default(true)
  ready   Boolean @default(false)

  // Metadata
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  accounts spoke_account[]
}

model spoke_account {
  id                 String   @id @default(cuid())
  spoke_id           String   @db.VarChar(50)
  spoke              spoke    @relation(fields: [spoke_id], references: [id], onDelete: Cascade)
  hive_account       String   @db.VarChar(16)
  environment        String   @db.VarChar(20)
  role               String   @db.VarChar(30)
  active             Boolean  @default(true)
  settlement_enabled Boolean  @default(false)
  primary            Boolean  @default(false)
  // Farm vendor payout destination (collected at hatch). Stored only; the
  // liman→SEPA payout rail is EMI/legal-gated future work.
  iban               String?  @db.VarChar(34)
  notes              String?  @db.Text
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  @@unique([spoke_id, hive_account, environment, role])
  @@index([spoke_id])
  @@index([hive_account])
  @@index([environment])
}
